{
  "version": 2,
  "outputDirectory": ".",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "env": {
    "DATABASE_URL": "@DATABASE_URL",
    "JWT_SECRET": "@JWT_SECRET",
    "PRISMA_API_KEY": "@PRISMA_API_KEY"
  },
  "routes": [
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/lib/(.*)", "dest": "/lib/$1" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
