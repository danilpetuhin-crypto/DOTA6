{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "noImplicitAny": false,
    "moduleDetection": "force"
  },
  "include": ["lib/**/*", "api/**/*", "models/**/*"],
  "exclude": ["node_modules", "generated", "dist", "**/*.ts"]
}
