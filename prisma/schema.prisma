generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  engineType    = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  login          String    @unique
  password       String
  ip             String?
  subscription   String    @default("free")
  analysesToday  Int       @default(0)
  subExpires     DateTime?
  licenseKey     String?
  sessions       Session[]
  analyses       Analysis[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String    @default("Текущая сессия")
  analyses  Analysis[]
  createdAt DateTime  @default(now())
}

model Analysis {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hole       String
  board      String?
  equity     Float?
  combo      String?
  action     String
  actionClass String
  pot        Float?
  outcome    String?
  createdAt  DateTime @default(now())
}
